      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_6_di" bpmnElement="T2_6">
        <dc:Bounds x="1590" y="115" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_7_di" bpmnElement="T2_7">
        <dc:Bounds x="1780" y="265" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_8_di" bpmnElement="T2_8">
        <dc:Bounds x="1970" y="265" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End2_di" bpmnElement="End2">
        <dc:Bounds x="2160" y="287" width="36" height="36" />
