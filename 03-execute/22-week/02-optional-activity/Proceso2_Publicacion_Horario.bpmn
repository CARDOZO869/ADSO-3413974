      <bpmndi:BPMNEdge id="SF4_di" bpmnElement="SF4"><di:waypoint x="1130" y="305" /><di:waypoint x="1210" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF5_di" bpmnElement="SF5"><di:waypoint x="1260" y="305" /><di:waypoint x="1400" y="305" /><bpmndi:BPMNLabel><dc:Bounds x="1390" y="287" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF6_di" bpmnElement="SF6"><di:waypoint x="1260" y="305" /><di:waypoint x="1425" y="305" /><di:waypoint x="1425" y="155" /><di:waypoint x="1590" y="155" /><bpmndi:BPMNLabel><dc:Bounds x="1415" y="137" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
