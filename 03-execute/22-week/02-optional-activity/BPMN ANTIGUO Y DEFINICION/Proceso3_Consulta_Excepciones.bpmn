      <bpmndi:BPMNShape id="End3_i_exc_di" bpmnElement="End3_i_exc">
        <dc:Bounds x="1222" y="187" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1199" y="226" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF1_di" bpmnElement="SF1">
        <di:waypoint x="486" y="205" />
        <di:waypoint x="640" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF2_di" bpmnElement="SF2">
        <di:waypoint x="750" y="205" />
        <di:waypoint x="830" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF3_di" bpmnElement="SF3">
