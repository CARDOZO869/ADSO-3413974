      <bpmndi:BPMNShape id="G3_1_di" bpmnElement="G3_1" isMarkerVisible="true">
        <dc:Bounds x="830" y="180" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="803" y="233" width="104" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start3_a_di" bpmnElement="Start3_a">
