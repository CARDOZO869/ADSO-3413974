digraph SAB {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline, fontname="Arial", labelloc=t, fontsize=20, label="Modelo lógico relacional · SAB"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=9, color="#596579", arrowsize=0.7];
"sede" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#DCE9FF"><B>sede</B></TD></TR><TR><TD ALIGN="LEFT">PK id_sede</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">ciudad</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>];
"programa" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#DCE9FF"><B>programa</B></TD></TR><TR><TD ALIGN="LEFT">PK id_programa</TD></TR><TR><TD ALIGN="LEFT">FK id_sede</TD></TR><TR><TD ALIGN="LEFT">codigo</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">activo</TD></TR></TABLE>>];
"ficha" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#DCE9FF"><B>ficha</B></TD></TR><TR><TD ALIGN="LEFT">PK id_ficha</TD></TR><TR><TD ALIGN="LEFT">FK id_programa</TD></TR><TR><TD ALIGN="LEFT">codigo</TD></TR><TR><TD ALIGN="LEFT">jornada</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>];
"rol" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#DCE9FF"><B>rol</B></TD></TR><TR><TD ALIGN="LEFT">PK id_rol</TD></TR><TR><TD ALIGN="LEFT">codigo</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR></TABLE>>];
"usuario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#DCE9FF"><B>usuario</B></TD></TR><TR><TD ALIGN="LEFT">PK id_usuario</TD></TR><TR><TD ALIGN="LEFT">FK id_rol</TD></TR><TR><TD ALIGN="LEFT">documento</TD></TR><TR><TD ALIGN="LEFT">correo</TD></TR><TR><TD ALIGN="LEFT">hash_contrasena</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>];
"inscripcion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#F3E8FF"><B>inscripcion</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK id_usuario</TD></TR><TR><TD ALIGN="LEFT">PK/FK id_ficha</TD></TR><TR><TD ALIGN="LEFT">PK fecha_inicio</TD></TR><TR><TD ALIGN="LEFT">fecha_fin</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>];
"ambiente" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#F3E8FF"><B>ambiente</B></TD></TR><TR><TD ALIGN="LEFT">PK id_ambiente</TD></TR><TR><TD ALIGN="LEFT">FK id_sede</TD></TR><TR><TD ALIGN="LEFT">codigo</TD></TR><TR><TD ALIGN="LEFT">capacidad</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>];
"horario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#DCFCE7"><B>horario</B></TD></TR><TR><TD ALIGN="LEFT">PK id_horario</TD></TR><TR><TD ALIGN="LEFT">FK id_ficha</TD></TR><TR><TD ALIGN="LEFT">FK id_instructor</TD></TR><TR><TD ALIGN="LEFT">FK id_ambiente</TD></TR><TR><TD ALIGN="LEFT">dia_semana</TD></TR><TR><TD ALIGN="LEFT">hora_inicio/fin</TD></TR></TABLE>>];
"sesion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#DCFCE7"><B>sesion</B></TD></TR><TR><TD ALIGN="LEFT">PK id_sesion</TD></TR><TR><TD ALIGN="LEFT">FK id_horario</TD></TR><TR><TD ALIGN="LEFT">fecha</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">codigo_expira</TD></TR></TABLE>>];
"credencial_identidad" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#F3E8FF"><B>credencial_identidad</B></TD></TR><TR><TD ALIGN="LEFT">PK id_credencial</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario</TD></TR><TR><TD ALIGN="LEFT">modalidad</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>];
"asistencia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#DCFCE7"><B>asistencia</B></TD></TR><TR><TD ALIGN="LEFT">PK id_asistencia</TD></TR><TR><TD ALIGN="LEFT">FK id_sesion</TD></TR><TR><TD ALIGN="LEFT">FK id_aprendiz</TD></TR><TR><TD ALIGN="LEFT">fecha_hora</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">metodo</TD></TR></TABLE>>];
"excusa" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#F3E8FF"><B>excusa</B></TD></TR><TR><TD ALIGN="LEFT">PK id_excusa</TD></TR><TR><TD ALIGN="LEFT">FK id_asistencia</TD></TR><TR><TD ALIGN="LEFT">FK id_revisor</TD></TR><TR><TD ALIGN="LEFT">motivo</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>];
"novedad" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#F3E8FF"><B>novedad</B></TD></TR><TR><TD ALIGN="LEFT">PK id_novedad</TD></TR><TR><TD ALIGN="LEFT">FK id_sede</TD></TR><TR><TD ALIGN="LEFT">FK id_autor</TD></TR><TR><TD ALIGN="LEFT">titulo</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>];
"notificacion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#F3E8FF"><B>notificacion</B></TD></TR><TR><TD ALIGN="LEFT">PK id_notificacion</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario</TD></TR><TR><TD ALIGN="LEFT">FK id_novedad</TD></TR><TR><TD ALIGN="LEFT">tipo</TD></TR><TR><TD ALIGN="LEFT">fecha_lectura</TD></TR></TABLE>>];
"auditoria" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#3157A4"><TR><TD BGCOLOR="#F3E8FF"><B>auditoria</B></TD></TR><TR><TD ALIGN="LEFT">PK id_evento</TD></TR><TR><TD ALIGN="LEFT">FK id_actor</TD></TR><TR><TD ALIGN="LEFT">accion</TD></TR><TR><TD ALIGN="LEFT">fecha_hora</TD></TR></TABLE>>];
"sede" -> "programa" [dir=both, arrowtail=none, arrowhead=vee, label="ofrece 0..*"];
"programa" -> "ficha" [dir=both, arrowtail=none, arrowhead=vee, label="organiza 0..*"];
"rol" -> "usuario" [dir=both, arrowtail=none, arrowhead=vee, label="asigna 0..*"];
"ficha" -> "horario" [dir=both, arrowtail=none, arrowhead=vee, label="programa 0..*"];
"usuario" -> "horario" [dir=both, arrowtail=none, arrowhead=vee, label="imparte 0..*"];
"ambiente" -> "horario" [dir=both, arrowtail=none, arrowhead=vee, label="recibe 0..*"];
"usuario" -> "asistencia" [dir=both, arrowtail=none, arrowhead=vee, label="marca 0..*"];
"asistencia" -> "excusa" [dir=both, arrowtail=none, arrowhead=vee, label="puede justificar 0..1"];
"sede" -> "novedad" [dir=both, arrowtail=none, arrowhead=vee, label="publica 0..*"];
}