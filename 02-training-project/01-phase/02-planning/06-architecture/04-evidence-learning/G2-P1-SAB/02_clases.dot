digraph G { rankdir=LR; graph [bgcolor="white",pad="0.3",label="Clases SAB · A2/A3",labelloc=t,fontsize=20]; node [shape=record,style=filled,fillcolor="#eef5ff",color="#39A900",fontname=Arial,fontsize=10]; edge [fontname=Arial,fontsize=9];
Usuario [label="{Usuario|-id:int\l-nombres:String\l-correo:String|+autenticar():bool\l}"]; Rol [label="{Rol|-id:int\l-codigo:String|+autorizar(accion:String):bool\l}"]; Ficha [label="{Ficha|-id:int\l-codigo:String\l-estado:String|+validarActiva():bool\l}"]; Sesion [label="{Sesion|-id:int\l-inicio:DateTime\l-estado:String|+abrir():void\l+cerrar():void\l}"]; Asistencia [label="{Asistencia|-id:int\l-instante:DateTime\l-estado:String|+esDuplicada():bool\l}"]; Credencial [label="{Credencial|-modalidad:String\l-estado:String|+estaVigente():bool\l}"]; Excusa [label="{Excusa|-motivo:String\l-estado:String|+resolver(estado:String):void\l}"]; Horario [label="{Horario|-dia:int\l-inicio:Time\l-fin:Time|+validarCruce():bool\l}"]; <<interface>> [label="{IVerificadorIdentidad|+verificar(usuario:Usuario):bool}",fillcolor="#e7fff1"]; WebAuthn [label="{VerificadorWebAuthn|+verificar(usuario:Usuario):bool}"]; Facial [label="{VerificadorFacial|+verificar(usuario:Usuario):bool}"]; Fachada [label="{FachadaAsistencia|+marcar(s:Sesion,u:Usuario,c:String):Asistencia}",fillcolor="#fff1df"]; Repo [label="{RepositorioAsistencia|+buscar(s:Sesion,u:Usuario):Asistencia\l+guardar(a:Asistencia):void}"];
Usuario->Rol [label="1 / 1"]; Ficha->Sesion [label="1 / 0..*"]; Horario->Sesion [label="1 / 0..*"]; Sesion->Asistencia [label="1 / 0..*"]; Usuario->Asistencia [label="1 / 0..*"]; Usuario->Credencial [label="1 / 0..*"]; Asistencia->Excusa [label="1 / 0..1"]; Fachada->Sesion [style=dashed,label="coordina"]; Fachada->Repo [style=dashed,label="Facade"]; Fachada->"<<interface>>" [style=dashed,label="Strategy"]; "<<interface>>"->WebAuthn [arrowhead=empty]; "<<interface>>"->Facial [arrowhead=empty]; }
